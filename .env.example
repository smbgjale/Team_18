# Leave everything empty to run in demo mode (local stand-in renderer, sample shops).

# Set a key to use a real AI image provider and vision model.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VISION_MODEL=gpt-4o-mini

# Force a provider: "mock" or "openai" (defaults to openai when a key is set, otherwise mock)
# RENDER_PROVIDER=
# VISION_PROVIDER=

# Where the SQLite database and uploaded/generated images are stored (default ./var)
# HOMELY_DATA_DIR=var
