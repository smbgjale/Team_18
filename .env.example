# Leave everything empty to run in demo mode (local stand-in renderer, sample shops).

# Free option: Cloudflare Workers AI (free daily allowance, no credit card needed).
# Account ID: Cloudflare dashboard > Account home > Account details.
# API token: My Profile > API Tokens > Create Token > "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# OpenAI is not used unless RENDER_PROVIDER or VISION_PROVIDER is set to "openai".
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VISION_MODEL=gpt-4o-mini

# Force a provider: "mock", "cloudflare" or "openai"
# RENDER_PROVIDER=
# VISION_PROVIDER=

# Image-to-3D is separate from the room image above. Leave this empty to save a GLB textured with the catalogue photo.
# With a key, "Create 3D models" sends that photo to Meshy and stores the GLB so the same product is not converted again.
# MESHY_API_KEY=
# IMAGE_TO_3D_PROVIDER=local
# MESHY_MODEL=latest

# Where the SQLite database and uploaded/generated images are stored (default ./var).
# On Vercel this uses /tmp locally in the function, and syncs durable state through Vercel Blob.
# HOMELY_DATA_DIR=var

# Required on Vercel so rooms/designs survive across serverless instances.
# Vercel dashboard → Storage → Create Database → Blob → connect to this project
# (injects BLOB_READ_WRITE_TOKEN automatically on deploy).
# BLOB_READ_WRITE_TOKEN=
